# Copy this file to .env.local, then replace every placeholder.
# Never put real server secrets in this example file or in variables prefixed with VITE_.

# Server-only Supabase configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SUPABASE_SECRET_KEY

# Admin credentials
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_HASH_FROM_CREATE_ADMIN_HASH_SCRIPT
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

# Local server settings
APP_ORIGIN=http://localhost:3000
API_PORT=3001

# Browser Supabase configuration. The publishable key is safe to expose.
# It is used only for signed PDF uploads; browser code does not access database tables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
